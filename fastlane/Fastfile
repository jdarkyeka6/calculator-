APP_IDENTIFIER = "com.jdarkyeka6.calculator"

default_platform(:ios)

platform :ios do
  desc "Create a signed iOS archive and send it to TestFlight"
  lane :beta do
    required = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_PRIVATE_KEY APPLE_TEAM_ID]
    missing = required.select { |name| ENV[name].to_s.strip.empty? }
    UI.user_error!("Missing GitHub secrets: #{missing.join(', ')}") unless missing.empty?

    raw_key = ENV.fetch("ASC_PRIVATE_KEY").strip
    key_contents = if raw_key.include?("BEGIN PRIVATE KEY")
      raw_key
    else
      require "base64"
      Base64.decode64(raw_key)
    end
    UI.user_error!("ASC_PRIVATE_KEY must contain a .p8 Apple API key") unless key_contents.include?("BEGIN PRIVATE KEY")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: key_contents,
      is_key_content_base64: false
    )

    require "spaceship"
    unless Spaceship::ConnectAPI::BundleId.find(APP_IDENTIFIER)
      Spaceship::ConnectAPI::BundleId.create(
        name: "Calculator CipherVault",
        identifier: APP_IDENTIFIER,
        platform: "IOS"
      )
    end

    UI.user_error!("Create an app with bundle ID #{APP_IDENTIFIER} in App Store Connect first") unless Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)

    create_keychain(
      name: "calculator-ci.keychain",
      password: "temporary-ci-keychain",
      default_keychain: true,
      unlock: true
    )

    cert(
      api_key: api_key,
      generate_apple_certs: true,
      keychain_path: File.expand_path("~/Library/Keychains/calculator-ci.keychain-db"),
      keychain_password: "temporary-ci-keychain"
    )
    sigh(api_key: api_key, app_identifier: APP_IDENTIFIER, force: true)
    profile = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: "Calculator.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: profile,
      targets: ["Calculator"]
    )

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      version: "1.0",
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: "Calculator.xcodeproj",
      build_number: latest.to_i + 1
    )

    build_app(
      project: "Calculator.xcodeproj",
      scheme: "Calculator",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: { APP_IDENTIFIER => profile }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
